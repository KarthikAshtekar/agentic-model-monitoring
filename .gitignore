# Python bytecode and packaging
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test, lint, type-check, and coverage outputs
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local environments and credentials
.venv/
venv/
.env
.env.*
!.env.example

# Editors, notebooks, and operating systems
.vscode/
.idea/
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# Generated or sensitive project inputs and outputs
data/reference/*
!data/reference/.gitkeep
data/production/*
!data/production/.gitkeep
data/scenarios/*
!data/scenarios/.gitkeep
artifacts/models/*
!artifacts/models/.gitkeep
artifacts/baselines/*
!artifacts/baselines/.gitkeep
artifacts/metadata/*
!artifacts/metadata/.gitkeep
artifacts/checkpoints/*
!artifacts/checkpoints/.gitkeep
registered_models/**/*.joblib
registered_models/**/*.parquet
!registered_models/**/.gitkeep
reports/generated/*
!reports/generated/.gitkeep
reports/figures/*
!reports/figures/.gitkeep
reports/onboarding/*
!reports/onboarding/.gitkeep

# Preserve only the parsed, isolated reliability rerun reports for review.
!reports/generated/diabetes_risk/
reports/generated/diabetes_risk/*
!reports/generated/diabetes_risk/reliability_rerun_01/
!reports/generated/diabetes_risk/reliability_rerun_01/**
